{
  "name": "dx-jquery",
  "version": "1.0.0",
  "scripts": {
    "start": "npm run lite",
    "build": "npm run lint",
    "lite": "lite-server -c ./bs-config.json",
    "lint-html": "prettier --check src/*",
    "lint-js": "eslint .",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx src/ --fix",
    "lint-css": "stylelint src/**/*.css --allow-empty-input",
    "lint": "npm-run-all -p -c lint-js lint-css lint-html"
  },
  "devDependencies": {
    "@babel/core": "^7.22.1",
    "@babel/eslint-parser": "^7.21.8",
    "eslint": "9.18.0",
    "eslint-config-devextreme": "1.1.9",
    "eslint-plugin-no-only-tests": "^3.1.0",
    "htmlhint": "^1.1.4",
    "lite-server": "^2.6.1",
    "npm-run-all": "^4.1.5",
    "prettier": "2.8.8",
    "stylelint": "^15.6.1",
    "stylelint-config-standard": "^33.0.0",
    "eslint-plugin-spellcheck": "^0.0.20"
  },
  "dependencies": {
    "@google-cloud/dialogflow": "^7.2.0",
    "body-parser": "^2.2.0",
    "browser-sync": "^3.0.2",
    "devextreme": "^25.2.3",
    "devextreme-dist": "^25.2.3",
    "express": "^5.0.0",
    "jquery": "^3.7.1",
    "path": "^0.12.7",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "type": "module"
}
